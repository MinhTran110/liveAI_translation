# ==========================================
# Live Voice Translate Configuration
# ==========================================

# Cloud ASR (Deepgram)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Translation LLM Providers (Anthropic or OpenAI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Translation Settings
TRANSLATOR_PROVIDER=anthropic
SOURCE_LANGUAGE=auto
TARGET_LANGUAGE=vi

# ASR Provider: "deepgram" (cloud) or "local" (faster-whisper)
TRANSCRIBER_PROVIDER=deepgram

# Local Whisper Model (if TRANSCRIBER_PROVIDER=local)
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Segment Buffer Thresholds
MIN_WORDS=5
MAX_WORDS=25
MAX_WAIT_SECONDS=2.5

# Audio Capture Settings
SAMPLE_RATE=16000
CHANNELS=1
CHUNK_SIZE=4096

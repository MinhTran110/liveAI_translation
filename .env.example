# API Keys for MemoAI Video Translate & Notes
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Translation Settings
TRANSLATOR_PROVIDER=anthropic
SOURCE_LANGUAGE=auto
TARGET_LANGUAGE=vi

# ASR Engine: "deepgram" (cloud) or "local" (faster-whisper)
ASR_ENGINE=deepgram

# Local Whisper Settings
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Web Server Settings
HOST=127.0.0.1
PORT=8000
